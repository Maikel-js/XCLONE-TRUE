DATABASE_URL=postgresql://user:password@localhost:5432/xclone
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# Register these callback URLs in both OAuth provider consoles:
# http://localhost:3000/auth/oauth/google/callback
# http://localhost:3000/auth/oauth/microsoft/callback
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional Microsoft tenant ID; "common" accepts work, school, and personal accounts.
MICROSOFT_TENANT_ID=common
